# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum
CLAUDE.md

# env file
.env
*/coverage.out
*/coverage.html
*/coverage.txt
.claude
graphify-out/
examples/loki-bench/bin/

# Compiled example binaries (each examples/<name> module builds to its own
# directory name, which has no extension and so escapes the rules above).
examples/*/*[!.]
!examples/*/*.go
!examples/*/*.md
!examples/*/*.mod
!examples/*/*.sum
!examples/*/*.yml
!examples/*/*.yaml
!examples/*/*.js
!examples/*/*/
